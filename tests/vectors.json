{
  "note": "Shared test vectors. Both the Python (patchproof.claims.replay_bound) and Rust (patchproof_verify::replay_bound) verifiers must return the 'expected' status for every case. A disagreement means one is wrong.",
  "cases": [
    {
      "name": "genuine class A",
      "certificate": {
        "kind": "farkas-elimination",
        "claim": {
          "defect_class": "A",
          "widths": {
            "index": 16,
            "size": 16
          },
          "proves": "every violating input is eliminated by the corrected guard"
        },
        "constraints": [
          {
            "label": "corrected: index < size",
            "form": "index - size + 1 <= 0",
            "multiplier": 1
          },
          {
            "label": "not safety: index >= size",
            "form": "- index + size <= 0",
            "multiplier": 1
          }
        ],
        "combination": "1 <= 0",
        "contradiction": "the combination has no variable terms and asserts 1 <= 0, which is false"
      },
      "expected": "VERIFIED"
    },
    {
      "name": "genuine class B",
      "certificate": {
        "kind": "farkas-elimination",
        "claim": {
          "defect_class": "B",
          "widths": {
            "payload": 16,
            "record": 17
          },
          "proves": "every violating input is eliminated by the corrected guard"
        },
        "constraints": [
          {
            "label": "corrected: payload + 8 <= record",
            "form": "payload - record + 8 <= 0",
            "multiplier": 1
          },
          {
            "label": "not safety: payload + 8 > record",
            "form": "- payload + record - 7 <= 0",
            "multiplier": 1
          }
        ],
        "combination": "1 <= 0",
        "contradiction": "the combination has no variable terms and asserts 1 <= 0, which is false"
      },
      "expected": "VERIFIED"
    },
    {
      "name": "genuine class C",
      "certificate": {
        "kind": "farkas-elimination",
        "claim": {
          "defect_class": "C",
          "widths": {
            "sel": 5,
            "base": 5
          },
          "proves": "every violating input is eliminated by the corrected guard"
        },
        "constraints": [
          {
            "label": "corrected: sel < 20",
            "form": "sel - 19 <= 0",
            "multiplier": 1
          },
          {
            "label": "not safety: sel >= 20",
            "form": "- sel + 20 <= 0",
            "multiplier": 1
          }
        ],
        "combination": "1 <= 0",
        "contradiction": "the combination has no variable terms and asserts 1 <= 0, which is false"
      },
      "expected": "VERIFIED"
    },
    {
      "name": "class A arithmetic, unbound",
      "certificate": {
        "kind": "farkas-elimination",
        "constraints": [
          {
            "label": "corrected: index < size",
            "form": "index - size + 1 <= 0",
            "multiplier": 1
          },
          {
            "label": "not safety: index >= size",
            "form": "- index + size <= 0",
